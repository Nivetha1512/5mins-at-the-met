{
  "name": "moma-pomodoro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "fetch-artworks": "node scripts/fetch-met-artworks.mjs",
    "fetch-artworks:catalog": "node scripts/fetch-met-artworks.mjs --skip-images",
    "generate-icon": "sips -c 1427 1427 public/artworks/irises.jpg --out /tmp/met-icon-crop.jpg && sips -s format png -z 1024 1024 /tmp/met-icon-crop.jpg --out src-tauri/app-icon.png && tauri icon src-tauri/app-icon.png -o src-tauri/icons && cp src-tauri/icons/128x128.png public/dock-icon.png"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "@tauri-apps/cli": "^2",
    "vitest": "^4.1.10"
  }
}
